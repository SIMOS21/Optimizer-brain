# Copy to .local/phase4a.env and generate independent random passwords.
BRAIN_MIGRATOR_PASSWORD=replace-with-a-random-password
BRAIN_APP_PASSWORD=replace-with-another-random-password
# API must use brain_app; only Alembic uses brain_migrator.
BRAIN_DATABASE_URL=postgresql+psycopg://brain_app:replace-with-another-random-password@127.0.0.1:55432/optimizer_brain
BRAIN_MIGRATION_DATABASE_URL=postgresql+psycopg://brain_migrator:replace-with-a-random-password@127.0.0.1:55432/optimizer_brain
