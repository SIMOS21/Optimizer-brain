{
  "schema_version": "1.0",
  "id": "demo_cross_department",
  "name": "Allocation synthétique à deux variables",
  "model_version": "1.0.0",
  "data_snapshot_id": "synthetic_demo_v1",
  "scenario_id": "base",
  "currency": "EUR",
  "departments": [
    {"id": "sales", "name": "Ventes"},
    {"id": "production", "name": "Production"},
    {"id": "finance", "name": "Finance"},
    {"id": "logistics", "name": "Logistique"}
  ],
  "parameters": {
    "machine_capacity_hours": {"value": "100", "unit": "hour", "source": "synthetic_demo", "approved": true, "version": "1"},
    "operating_cash_budget_eur": {"value": "8000", "unit": "EUR", "source": "synthetic_demo", "approved": true, "version": "1"},
    "delivery_capacity_units": {"value": "55", "unit": "unit", "source": "synthetic_demo", "approved": true, "version": "1"}
  },
  "variables": [
    {"id": "qty_A", "type": "INTEGER", "lb": "0", "ub": "40", "unit": "unit", "department": "sales"},
    {"id": "qty_B", "type": "INTEGER", "lb": "0", "ub": "35", "unit": "unit", "department": "sales"}
  ],
  "constraints": [
    {
      "id": "production_machine", "owner_department": "production", "kind": "HARD",
      "source": "synthetic_demo", "approved": true, "version": "1",
      "terms": [
        {"variable": "qty_A", "coefficient": "2", "coefficient_unit": "hour/unit"},
        {"variable": "qty_B", "coefficient": "1", "coefficient_unit": "hour/unit"}
      ],
      "operator": "<=", "rhs": {"parameter": "machine_capacity_hours"}, "unit": "hour"
    },
    {
      "id": "finance_budget", "owner_department": "finance", "kind": "HARD",
      "source": "synthetic_demo", "approved": true, "version": "1",
      "terms": [
        {"variable": "qty_A", "coefficient": "100", "coefficient_unit": "EUR/unit"},
        {"variable": "qty_B", "coefficient": "200", "coefficient_unit": "EUR/unit"}
      ],
      "operator": "<=", "rhs": {"parameter": "operating_cash_budget_eur"}, "unit": "EUR"
    },
    {
      "id": "logistics_delivery", "owner_department": "logistics", "kind": "HARD",
      "source": "synthetic_demo", "approved": true, "version": "1",
      "terms": [
        {"variable": "qty_A", "coefficient": "1", "coefficient_unit": "unit/unit"},
        {"variable": "qty_B", "coefficient": "1", "coefficient_unit": "unit/unit"}
      ],
      "operator": "<=", "rhs": {"parameter": "delivery_capacity_units"}, "unit": "unit"
    }
  ],
  "objectives": [
    {
      "id": "maximize_contribution", "owner_department": "finance", "sense": "MAX", "priority": 1,
      "source": "synthetic_demo", "approved": true, "version": "1", "unit": "EUR",
      "terms": [
        {"variable": "qty_A", "coefficient": "80", "coefficient_unit": "EUR/unit"},
        {"variable": "qty_B", "coefficient": "60", "coefficient_unit": "EUR/unit"}
      ]
    }
  ]
}
